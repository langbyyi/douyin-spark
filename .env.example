# 原生部署：复制为 config.toml 同目录的 .env；Docker 部署：使用项目根目录的 .env。
# 凭据文件不得提交至版本控制；注释独立成行。

# Server酱 SendKey（SCT... 或 sctp...）；支持与 PushPlus 同时配置。
# SPARK_SERVERCHAN_KEY=

# PushPlus token；两个渠道均未配置时禁用远程通知。
# SPARK_PUSHPLUS_TOKEN=

# 默认通过控制面板管理通知凭据，上述变量保持注释状态。
# 通过部署配置管理时，取消对应注释并填写凭据；变量空值亦会覆盖面板保存结果。
# 既有部署切换为面板管理时，注销对应变量定义并重新创建容器；参见 docs/cloud.md。

# 账号代理：由 config.toml 的 proxy = "${MAIN_PROXY}" 引用；变量未定义或为空时配置校验失败。
# MAIN_PROXY=http://user:pass@proxy.example.com:8080

# 面板初始密码：仅首次初始化时读取；未配置时随机生成并显示一次。
# 最少 8 个字符；初始化后修改该变量不更新已保存的密码。
# 面板密码修改结果持久化保存；重置命令为 spark password reset，参见 docs/usage.md。
# SPARK_GUI_PASSWORD=

# Linux 服务器及 Docker 部署参数
# 独立 CLI/MCP 登录服务的外部入口，可配置于 config.toml [login]；GUI 登录验证使用面板入口。
# SPARK_PUBLIC_URL=http://127.0.0.1:8789
# 独立 CLI/MCP 登录服务监听参数；远程 HTTP 访问使用 SSH 本地转发。
# SPARK_LOGIN_BIND=0.0.0.0
# SPARK_LOGIN_HTTP_PORT=8789
# --mode vnc 必填，最少 6 个字符；登录流程结束后关闭服务。
# SPARK_VNC_PASSWORD=
# noVNC 端口；变更后同步调整容器端口映射与 SSH 转发。
# SPARK_VNC_PORT=6080
# HTTPS 反向代理的实际来源地址；按部署网络配置，不接受通配符 *。
# 可信代理传递 X-Forwarded-Port 后，面板支持 Host $host 的非默认端口入口。
# SPARK_GUI_TRUSTED_PROXIES=172.18.0.1
# Docker 镜像预设以下环境变量：
# SPARK_ENV=cloud
# SPARK_DATA_DIR=/data
